# KisanGuard Backend — Environment Configuration
# Copy this file to .env and fill in values from AWS dev team

# App
APP_VERSION=2.0.0
AWS_REGION=ap-south-1
LOG_LEVEL=INFO

# S3
S3_BUCKET=kisanguard-data-ap-south-1
S3_FEATURE_CACHE_TTL_MINUTES=60

# DynamoDB
DYNAMO_USERS_TABLE=kisanguard-users
DYNAMO_FEATURES_TABLE=kisanguard-features
DYNAMO_AUDIT_TABLE=kisanguard-audit
DYNAMO_ALERTS_TABLE=kisanguard-alerts
DYNAMO_PIPELINE_TABLE=kisanguard-pipeline-status
DYNAMO_CALENDARS_TABLE=kisanguard-crop-calendars

# Timestream
TIMESTREAM_DB=kisanguard
TIMESTREAM_TABLE=wbgt-forecasts

# Cognito (get from AWS dev / frontend dev)
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_JWKS_URL=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_XXXXXXXXX/.well-known/jwks.json

# SageMaker (fallback endpoints — get from AWS dev)
SAGEMAKER_WBGT_ENDPOINT=kisanguard-wbgt-v1
SAGEMAKER_CDHI_ENDPOINT=kisanguard-cdhi-csyr-v2

# Bedrock
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6-20250514
BEDROCK_MAX_TOKENS=150
BEDROCK_TEMPERATURE=0.3

# Trust Layer
CONFIDENCE_THRESHOLD=0.85
MISSING_DATA_THRESHOLD=0.10
WBGT_MIN_C=5.0
WBGT_MAX_C=50.0

# A2I (get from AWS dev)
A2I_FLOW_ARN=arn:aws:sagemaker:ap-south-1:XXXXXXXXXXXX:flow-definition/kisanguard-review
A2I_OUTPUT_S3_PREFIX=a2i/
A2I_RED_SLA_MINUTES=15
A2I_OTHER_SLA_MINUTES=120

# Step Functions (get from AWS dev)
STEP_FUNCTIONS_ALERT_PIPELINE_ARN=arn:aws:states:ap-south-1:XXXXXXXXXXXX:stateMachine:kisanguard-alert-pipeline
STEP_FUNCTIONS_RETRAIN_PIPELINE_ARN=arn:aws:states:ap-south-1:XXXXXXXXXXXX:stateMachine:kisanguard-retrain-pipeline

# Alert Delivery (get from AWS dev)
SNS_ORIGINATION_NUMBER=+91XXXXXXXXXX
PINPOINT_APP_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SNS_OPS_TOPIC_ARN=arn:aws:sns:ap-south-1:XXXXXXXXXXXX:kisanguard-ops

# Alert Fatigue
MAX_RED_ALERTS_PER_DAY=1
MAX_CAUTION_ALERTS_PER_DAY=3

# KMS (get from AWS dev)
KMS_CMK_ARN=arn:aws:kms:ap-south-1:XXXXXXXXXXXX:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Partner Webhooks
PARTNER_KEY_SECRET_NAME=kisanguard/partner-keys

# MLOps
SAGEMAKER_MODEL_REGISTRY_GROUP=kisanguard-models

# Local Dev
USE_LOCAL_MODELS=true
LOCALSTACK_ENDPOINT=http://localhost:4566
